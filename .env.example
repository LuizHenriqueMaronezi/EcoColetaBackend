# Copie para .env e preencha. O .env NUNCA vai para o git.

# Banco Neon (Dashboard do Neon > Connection string). Sem esta linha, usa SQLite local.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST.neon.tech/neondb?sslmode=require

# IP desta máquina na rede (o celular acessa a API por ele), separado por vírgula
ALLOWED_HOSTS=192.168.0.10,localhost,127.0.0.1

# Mosquitto local (o mesmo usuário/senha criados pelo infra/windows/setup-mosquitto.ps1)
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USER=backend
MQTT_PASSWORD=troque-esta-senha
MQTT_TOPIC_PREFIX=ecocoleta/lixeiras

# Regras da coleta. COLLECTION_SECONDS deve ser igual ao TEMPO_COLETA do firmware (em ms).
COLLECTION_SECONDS=180
FULL_THRESHOLD=90
